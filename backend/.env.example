# ==============================================
# ENVIRONMENT CONFIGURATION
# ==============================================
# Set to "development" or "production"
ENVIRONMENT=development

# ==============================================
# SLACK CONFIGURATION
# ==============================================
# Get these from: https://api.slack.com/apps
# Required for production, optional for development

# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=

# Signing Secret (32-character hex string)
SLACK_SIGNING_SECRET=

# ==============================================
# GITHUB CONFIGURATION
# ==============================================
# Personal Access Token (PAT) for automated PR creation
# Required for GitHub integration features
# Get from: https://github.com/settings/tokens
# Needs 'repo' scope for private repos, 'public_repo' for public repos

GITHUB_TOKEN=

# Note: Repository name comes from Slack command parameter, not env var!
# Usage in Slack: /playbookpulse username/repo-name

# ==============================================
# GEMINI API CONFIGURATION
# ==============================================
# Get your API key from: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, perfect for hackathons!

GOOGLE_API_KEY=

# ==============================================
# SERVER CONFIGURATION
# ==============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
